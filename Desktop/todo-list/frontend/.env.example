# Base URL of the Spring Boot backend, no trailing slash.
VITE_API_BASE_URL=http://localhost:8080

# Landing page review form. Reviews are emailed by Web3Forms (free, no card).
# Get a key at https://web3forms.com: enter the address that should receive
# reviews and the key is emailed to you. It is public by design (it only says
# where to forward submissions), so it is safe in a Vite env var.
# Restart `npm run dev` after changing this; on Vercel, add it under
# Project Settings -> Environment Variables and redeploy.
VITE_WEB3FORMS_ACCESS_KEY=
